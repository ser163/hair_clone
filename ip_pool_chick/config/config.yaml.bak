database:
  host: "127.0.0.1"
  port: 3306
  username: "root"
  password: "xxxxxx"
  dbname: "ip_pool"
  charset: "utf8mb4"

redis:
  addr: "127.0.0.1:6379"
  poolKey: "ip_pool"
  setKey: "ip_pool_set"

check:
  portTimeout: 3s
  httpTimeout: 5s
  targetURL: "http://www.baidu.com"
pool:
  ipNumber: 20